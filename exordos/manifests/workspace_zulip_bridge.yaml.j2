name: "workspace_zulip_bridge"
description: "Low-latency Workspace and Zulip integration bridge"
schema_version: 1
version: "{{ version }}"
api_version: "v1"

requirements:
  core:
    from_version: "0.0.0"

resources:
  $core.compute.nodes:
    bridge_node:
      name: "workspace-zulip-bridge"
      description: "Workspace Zulip bridge service and local PostgreSQL"
      project_id: "{{ project_id }}"
      cores: {{ cores | default(2) }}
      ram: {{ ram | default(4096) }}
      disk_spec:
        kind: "disks"
        disks:
          - label: "root"
            size: 6
            image: "{{ repository | default('https://repo.exordos.com/exordos-elements') }}/workspace-zulip-bridge/{{ version }}/images/workspace-zulip-bridge.raw.zst"
          - label: "data"
            size: {{ data_disk_size | default(20) }}

exports:
  bridge_node:
    kind: "resource"
    link: "$workspace_zulip_bridge.compute.nodes.$bridge_node"

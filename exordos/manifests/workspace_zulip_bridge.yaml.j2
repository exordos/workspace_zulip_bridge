name: "workspace_zulip_bridge"
description: "Low-latency Workspace and Zulip integration bridge"
schema_version: 1
version: "{{ version }}"
api_version: "v1"

requirements:
  core:
    from_version: "0.0.0"

resources:
  $core.compute.nodes:
    bridge_node:
      name: "workspace-zulip-bridge"
      description: "Workspace Zulip bridge service and local PostgreSQL"
      project_id: "12345678-c625-4fee-81d5-f691897b8142"
      cores: 2
      ram: 4096
      disk_spec:
        kind: "disks"
        disks:
          - size: 6
            image: "{{ images['workspace_zulip_bridge'] }}"
            label: root
          - size: 20
            label: data

exports:
  bridge_node:
    kind: "resource"
    link: "$core.compute.nodes.$bridge_node"

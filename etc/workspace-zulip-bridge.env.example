# Keep this file free of provider credentials. Exordos Core-managed secrets can
# be exposed through a root-readable environment file when adapters are added.
WZB_DATABASE_DSN=postgresql:///workspace_zulip_bridge?host=/var/run/postgresql
WZB_DB_POOL_MIN_SIZE=2
WZB_DB_POOL_MAX_SIZE=16
WZB_DB_COMMAND_TIMEOUT_SECONDS=30
WZB_DB_PROBE_SECONDS=30
WZB_USER_REFRESH_SECONDS=5
# WZB_ZULIP_CA_FILE=/etc/ssl/certs/internal-zulip-ca.pem
WZB_ZULIP_CONNECT_TIMEOUT_SECONDS=10
WZB_ZULIP_DEFAULT_LONGPOLL_TIMEOUT_SECONDS=180
WZB_ZULIP_DB_ACK_TIMEOUT_SECONDS=120
WZB_ZULIP_RETRY_BASE_SECONDS=1
WZB_ZULIP_RETRY_CAP_SECONDS=60
WZB_ZULIP_IDLE_QUEUE_TIMEOUT_SECONDS=3600
WZB_ZULIP_REGISTRATION_CONCURRENCY=8
# All user threads remain live; this bounds simultaneous 5000-message JSON pages.
WZB_ZULIP_MESSAGE_SCAN_CONCURRENCY=32
WZB_ZULIP_HISTORY_CONCURRENCY=12
WZB_ZULIP_DIRECTORY_CACHE_TTL_SECONDS=60
WZB_ZULIP_CHAT_FILL_TIMEOUT_SECONDS=120
WZB_ZULIP_MESSAGE_PAGE_SIZE=5000
WZB_EVENT_PROCESSOR_BATCH_SIZE=1000
WZB_EVENT_PROCESSOR_POLL_SECONDS=0.05
WZB_EVENT_PROCESSOR_CLAIM_TIMEOUT_SECONDS=60
# Terminal applied/skipped/failed events are retained for one day.
WZB_EVENT_RETENTION_SECONDS=86400
WZB_EVENT_CLEANUP_INTERVAL_SECONDS=300
WZB_EVENT_CLEANUP_BATCH_SIZE=10000
WZB_THREAD_STOP_TIMEOUT_SECONDS=5
WZB_LOG_LEVEL=INFO
